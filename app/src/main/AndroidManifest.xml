<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/regras_extracao_dados"
        android:fullBackupContent="@xml/regras_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Tema.Pulso">

        <activity
            android:name=".abertura.TelaAbertura"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Tema.Pulso.Abertura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".login.TelaLogin"
            android:screenOrientation="portrait" />

        <activity
            android:name=".cadastro.TelaCadastro"
            android:screenOrientation="portrait" />

        <activity
            android:name=".recuperarsenha.TelaRecuperarSenha"
            android:screenOrientation="portrait" />

        <activity
            android:name=".inicio.TelaInicio"
            android:screenOrientation="portrait" />

        <activity
            android:name=".treinos.TelaTreinos"
            android:screenOrientation="portrait" />

        <activity
            android:name=".detalhetreino.TelaDetalheTreino"
            android:screenOrientation="portrait" />

        <activity
            android:name=".execucao.TelaExecucaoTreino"
            android:screenOrientation="portrait" />

        <activity
            android:name=".historico.TelaHistorico"
            android:screenOrientation="portrait" />

        <activity
            android:name=".avaliacao.TelaAvaliacaoFisica"
            android:screenOrientation="portrait" />

        <activity
            android:name=".aulas.TelaAulas"
            android:screenOrientation="portrait" />
    </application>

</manifest>
