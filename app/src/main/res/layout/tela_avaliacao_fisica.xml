<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="@dimen/espaco_16">

        <ImageButton
            android:id="@+id/botaoVoltar"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voltar"
            android:src="@drawable/icone_seta_esquerda" />

        <TextView
            style="@style/Texto.Pulso.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_8"
            android:text="@string/titulo_avaliacao_fisica" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaco_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/medidaPeso"
                    layout="@layout/item_medida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_8"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/medidaAltura"
                    layout="@layout/item_medida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_16"
                android:orientation="horizontal">

                <include
                    android:id="@+id/medidaImc"
                    layout="@layout/item_medida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_8"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/medidaGordura"
                    layout="@layout/item_medida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Componente.Pulso.Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_16">

                    <TextView
                        style="@style/Texto.Pulso.Corpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_semibold"
                        android:text="@string/evolucao_peso" />

                    <br.unifor.pulso.avaliacao.GraficoPeso
                        android:id="@+id/grafico"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="@dimen/espaco_16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Pulso.Secao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_24"
                android:text="@string/dobras_cutaneas" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Componente.Pulso.Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_8"
                app:cardCornerRadius="@dimen/raio_12">

                <LinearLayout
                    android:id="@+id/listaDobras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                style="@style/Componente.Pulso.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_16"
                android:text="@string/agendar_avaliacao" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacao"
        style="@style/Componente.Pulso.Navegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_navegacao" />
</LinearLayout>
