<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espaco_24"
    android:paddingBottom="@dimen/espaco_16">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoServico"
                style="@style/Texto.Pulso.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Texto.Pulso.Corpo.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirme_inscricao" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botaoFechar"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fechar"
            android:src="@drawable/icone_fechar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_16"
        android:background="@drawable/fundo_caixa"
        android:orientation="vertical"
        android:padding="@dimen/espaco_16">

        <TextView
            android:id="@+id/textoData"
            style="@style/Texto.Pulso.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/espaco_16"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/icone_calendario"
            app:drawableTint="@color/anil" />

        <TextView
            android:id="@+id/textoHorario"
            style="@style/Texto.Pulso.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_8"
            android:drawablePadding="@dimen/espaco_16"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/icone_relogio"
            app:drawableTint="@color/anil" />

        <TextView
            android:id="@+id/textoInstrutor"
            style="@style/Texto.Pulso.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_8"
            android:drawablePadding="@dimen/espaco_16"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/icone_pessoa"
            app:drawableTint="@color/anil" />

        <TextView
            android:id="@+id/textoSala"
            style="@style/Texto.Pulso.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_8"
            android:drawablePadding="@dimen/espaco_16"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/icone_marcador_mapa"
            app:drawableTint="@color/anil" />

        <TextView
            android:id="@+id/textoVagas"
            style="@style/Texto.Pulso.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_8"
            android:drawablePadding="@dimen/espaco_16"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/icone_grupo"
            app:drawableTint="@color/anil" />
    </LinearLayout>

    <TextView
        style="@style/Texto.Pulso.Legenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_16"
        android:fontFamily="@font/jakarta_regular"
        android:text="@string/aviso_cancelamento" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoConfirmar"
        style="@style/Componente.Pulso.Botao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_16"
        android:text="@string/confirmar_inscricao" />

    <TextView
        android:id="@+id/linkVoltar"
        style="@style/Texto.Pulso.Link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_8"
        android:text="@string/voltar" />
</LinearLayout>
