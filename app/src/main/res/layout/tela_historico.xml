<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaco_24">

            <TextView
                style="@style/Texto.Pulso.Destaque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_16"
                android:text="@string/titulo_historico" />

            <LinearLayout
                android:id="@+id/comSessoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_24"
                    android:background="@drawable/fundo_cartao_anil"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/fundo_circulo_azul"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/icone_tendencia_alta"
                        app:tint="@color/anil" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textoSequencia"
                            style="@style/Texto.Pulso.Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/branco" />

                        <TextView
                            style="@style/Texto.Pulso.Corpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/continue_treinando"
                            android:textColor="@color/azul_claro"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listaSessoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/semSessoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/espaco_48"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/fundo_circulo_azul"
                    android:importantForAccessibility="no"
                    android:padding="28dp"
                    android:src="@drawable/icone_calendario"
                    app:tint="@color/anil" />

                <TextView
                    style="@style/Texto.Pulso.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_24"
                    android:text="@string/historico_vazio_titulo" />

                <TextView
                    style="@style/Texto.Pulso.Corpo.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:gravity="center"
                    android:text="@string/historico_vazio_texto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoTreinoDeHoje"
                    style="@style/Componente.Pulso.Botao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_24"
                    android:text="@string/ver_treino_de_hoje" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacao"
        style="@style/Componente.Pulso.Navegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_navegacao" />
</LinearLayout>
